{
  "inputs": [
    {
      "type": "promptString",
      "id": "netlify-token",
      "description": "Netlify Personal Access Token (Settings → OAuth → Personal access tokens)",
      "password": true
    }
  ],
  "servers": {
    "netlify": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@netlify/mcp"],
      "env": {
        "NETLIFY_PERSONAL_ACCESS_TOKEN": "${input:netlify-token}"
      }
    }
  }
}
